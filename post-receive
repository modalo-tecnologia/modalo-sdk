#!/bin/bash
echo "📦 Recebendo novo código na Modalo..."

# USE O CAMINHO COMPLETO AQUI (Exemplo baseado na sua .var)
TARGET_DIR="/home/dev/.var/www/modalo-producao"
GIT_DIR="/home/dev/.var/git/modalo.git"

mkdir -p $TARGET_DIR

# Comando de checkout com caminhos fixos
git --work-tree=$TARGET_DIR --git-dir=$GIT_DIR checkout -f

cd $TARGET_DIR

# Se o 'bun' não for encontrado, use o caminho completo dele (ex: /home/dev/.bun/bin/bun)
echo "⚙️ Instalando pacotes..."
~/.bun/bin/bun install

echo "🔄 Reiniciando serviços..."
~/.bun/bin/pm2 restart modalo-api || ~/.bun/bin/pm2 start backend.js --name "modalo-api"

echo "✅ Deploy concluído via Git!"
